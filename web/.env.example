# GlideTop — environment variables
# Copy to web/.env for local development. In production set these in Coolify.

# --- Shopify app credentials (Partner Dashboard → GlideTop → API credentials) --
# SHOPIFY_API_KEY must ALSO be passed as a Docker build argument: the frontend
# bundle bakes it in at build time. Setting it only at runtime yields a broken
# admin UI that reports "Missing Shopify API Key".
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of this deployment, no trailing slash.
HOST=https://glidetop.example.com

# Admin API access scopes, comma separated. GlideTop needs none — leave empty.
SCOPES=

# --- Runtime ---------------------------------------------------------------
PORT=8081
NODE_ENV=production

# --- Session storage -------------------------------------------------------
MONGODB_URI=mongodb://user:password@host:27017
MONGODB_DB=glidetop

# --- Billing ---------------------------------------------------------------
# true  -> Shopify creates TEST charges (no real money). Use for App Store
#          review and QA.
# false -> real charges. Set this before going live.
BILLING_TEST=false

# Subscription names as they appear on merchants' Shopify invoices. Changing
# these after merchants subscribe will report them as "free" and strip their
# paid features — only set them if you must match pre-existing subscriptions.
# BASIC_PLAN_NAME=GlideTop Basic
# PREMIUM_PLAN_NAME=GlideTop Premium

# --- Frontend build-time values (Docker build args, not runtime) ------------
# Theme app extension UUID, from Partner Dashboard → Extensions → GlideTop.
# Without it, "Open theme editor" lands on the App embeds panel without
# pre-selecting GlideTop. Everything still works, it is just one extra click.
GLIDETOP_EXTENSION_UUID=

# Monitored support address shown in the admin UI. Shopify requires a working
# one before the app can be listed.
GLIDETOP_SUPPORT_EMAIL=
